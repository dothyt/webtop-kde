# System-wide GNOME defaults for the os4agent desktop (replaces the old
# captured plasma.tar.gz). Compiled into /etc/dconf/db/local by
# `dconf update` at build time. Nothing here is locked, so per-user
# gsettings writes still win.

# Never blank, lock or suspend — the session is only ever viewed
# through Selkies, and a lock screen would strand the agent.
[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
lock-enabled=false
idle-activation-enabled=false

[org/gnome/desktop/lockdown]
disable-lock-screen=true

[org/gnome/settings-daemon/plugins/power]
idle-dim=false
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

# Software rendering (llvmpipe under Xvfb): skip animations so
# screenshots aren't taken mid-transition.
[org/gnome/desktop/interface]
enable-animations=false

# Don't auto-maximize windows that open close to screen size (VLC with
# the spec's argv otherwise ends up covering the desktop icons).
[org/gnome/mutter]
auto-maximize=false

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/Jammy-Jellyfish-Purple.jpg'
picture-uri-dark='file:///usr/share/backgrounds/Jammy-Jellyfish-Purple.jpg'
picture-options='zoom'

# Dock launchers, same set/order as the old Plasma task manager.
[org/gnome/shell]
favorite-apps=['chromium.desktop', 'com.microsoft.VSCode.desktop', 'vlc.desktop', 'org.gnome.TextEditor.desktop', 'libreoffice-writer.desktop', 'libreoffice-calc.desktop', 'libreoffice-impress.desktop', 'gimp.desktop', 'thunderbird.desktop', 'org.gnome.Settings.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop']
welcome-dialog-last-shown-version='999'
