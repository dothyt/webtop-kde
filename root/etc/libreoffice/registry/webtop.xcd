<?xml version="1.0" encoding="UTF-8"?>
<!--
  System-wide LibreOffice defaults for the webtop desktop: no first-run
  pop-ups that steal focus from the agent. LibreOffice has no command-line
  switch for these (nofirststartwizard is a no-op since 4.x); they're
  config keys, and any *.xcd in share/registry (-> /etc/libreoffice/registry
  on Ubuntu) sets their defaults for every new user profile.
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <oor:component-data oor:name="Setup" oor:package="org.openoffice">
    <node oor:name="Product">
      <!-- "You are running version X for the first time" infobar: shown
           while this is older than the installed version (jammy: 7.3). -->
      <prop oor:name="ooSetupLastVersion" oor:op="fuse">
        <value>7.3</value>
      </prop>
      <!-- "Help us make LibreOffice even better" / donation infobars:
           shown once these timestamps are more than 90 days old. -->
      <prop oor:name="LastTimeGetInvolvedShown" oor:op="fuse">
        <value>4102444800</value>
      </prop>
      <prop oor:name="LastTimeDonateShown" oor:op="fuse">
        <value>4102444800</value>
      </prop>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Misc">
      <prop oor:name="ShowTipOfTheDay" oor:op="fuse">
        <value>false</value>
      </prop>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Impress" oor:package="org.openoffice.Office">
    <node oor:name="Misc">
      <node oor:name="NewDoc">
        <!-- "Select a Template" dialog on every new presentation (its
             "Show this dialog at startup" box). Off in the OSWorld VM. -->
        <prop oor:name="AutoPilot" oor:op="fuse">
          <value>false</value>
        </prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
