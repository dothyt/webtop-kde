#!/usr/bin/with-contenv bash
# Move webtop's existing bottom panel(s) to the left edge — visually
# closer to the OSWorld GNOME VM's Activities dash. We don't add a
# new panel; we mutate the existing org.kde.panel containment(s)
# from formfactor=Horizontal/location=BottomEdge to
# formfactor=Vertical/location=LeftEdge.
#
# Timing: same fix as 40-plasma-look. cont-init.d runs before the
# user session, so plasma-org.kde.plasma.desktop-appletsrc doesn't
# exist yet on a fresh /config tmpfs. Spawn a background waiter
# that fires after plasmashell finishes its first-run config flush.

set -euo pipefail

(
    CONF=/config/.config/plasma-org.kde.plasma.desktop-appletsrc

    deadline=$(($(date +%s) + 90))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        if pgrep -u abc -x plasmashell >/dev/null 2>&1 \
                && [ -f "$CONF" ]; then
            break
        fi
        sleep 1
    done
    sleep 4   # let plasma flush its first-run config

    [ -f "$CONF" ] || exit 0

    # Find every panel containment (org.kde.panel). Webtop ships with
    # one or two horizontal panels; mutate them all so we don't leave
    # a stale bottom-edge panel co-existing with the new vertical one.
    panel_ids=$(awk '
      /^\[Containments\]\[/ {
        cur = $0
        sub(/^\[Containments\]\[/, "", cur)
        sub(/\]$/, "", cur)
      }
      cur != "" && /^plugin=org\.kde\.panel$/ { print cur; cur = "" }
    ' "$CONF")

    if [ -z "$panel_ids" ]; then
        echo "[panel-left] no org.kde.panel containment in $CONF" >&2
        exit 0
    fi

    # FormFactor: Horizontal=2 → Vertical=3
    # Location:   BottomEdge=4 → LeftEdge=5
    for pid in $panel_ids; do
        runuser -u abc -- kwriteconfig5 \
            --file "$CONF" \
            --group Containments --group "$pid" \
            --key formfactor 3 \
            --key location 5 || true
    done

    runuser -u abc -- env DISPLAY=:1 dbus-launch --exit-with-session \
        qdbus org.kde.plasmashell /PlasmaShell evaluateScript \
        'for (var i in desktops()) { desktops()[i].reloadConfig(); }' \
        >/dev/null 2>&1 || true

    # Panel relocation needs a plasmashell restart to actually
    # take effect — the live reloadConfig above doesn't move panels.
    # Restart in-place; KWin keeps everything else.
    runuser -u abc -- env DISPLAY=:1 \
        kquitapp5 plasmashell >/dev/null 2>&1 || true
    sleep 1
    runuser -u abc -- env DISPLAY=:1 \
        nohup plasmashell >/dev/null 2>&1 &
) &
