#!/usr/bin/with-contenv bash
# Move webtop's existing bottom panel to the left edge — visually
# closer to the GNOME OSWorld VM's Activities dash, and gets the
# system tray + clock + Kickoff out of the agent's primary working
# area (the desktop center / right where VLC and file dialogs live).
#
# We don't add a new panel; we mutate the existing one's containment
# in plasma-org.kde.plasma.desktop-appletsrc. Find the panel by
# scanning for `plugin=org.kde.panel` (defensive: don't assume
# Containment ID 2 is always the panel — Plasma renumbers when
# new screens or virtual desktops are added).
#
# /config is tmpfs at runtime, so this re-runs each container start.
# Idempotent: kwriteconfig5 writing the same value is a no-op.

set -euo pipefail

CONF=/config/.config/plasma-org.kde.plasma.desktop-appletsrc

# Defer if plasmashell hasn't done its first-run write yet.
if [ ! -f "$CONF" ]; then
    exit 0
fi

# Find the panel containment ID. mawk-compatible (no gawk-specific
# match() second arg).
PANEL_ID=$(awk '
  /^\[Containments\]\[/ {
    cur = $0
    sub(/^\[Containments\]\[/, "", cur)
    sub(/\]$/, "", cur)
  }
  cur != "" && /^plugin=org\.kde\.panel$/ { print cur; exit }
' "$CONF")

if [ -z "$PANEL_ID" ]; then
    echo "[panel-left] no org.kde.panel containment found in $CONF" >&2
    exit 0
fi

# Plasma::Types::FormFactor: Horizontal=2, Vertical=3
# Plasma::Types::Location:   BottomEdge=4, LeftEdge=5
runuser -u abc -- kwriteconfig5 \
    --file "$CONF" \
    --group Containments --group "$PANEL_ID" \
    --key formfactor 3 \
    --key location 5 || true

# Default visibility is "Always visible" already; no need to set
# panelVisibility/panelHiding explicitly. If a future Plasma version
# changes this default, add:
#   --group Containments --group "$PANEL_ID" --key panelVisibility 0
