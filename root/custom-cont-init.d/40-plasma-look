#!/usr/bin/with-contenv bash
# This script used to apply wallpaper + sortMode via kwriteconfig5 from
# cont-init.d (with a background waiter for plasmashell). That approach
# raced plasma's first-run config write — the partial mutations either
# got clobbered or confused plasma into spawning fresh default panels.
#
# Replaced by /etc/xdg/autostart/os4agent-plasma-fixup.desktop, which
# runs in the user session AFTER plasma is up. Kept this file as an
# explicit no-op so it's clear from `ls /custom-cont-init.d/` that
# nothing here fires anymore.
exit 0
