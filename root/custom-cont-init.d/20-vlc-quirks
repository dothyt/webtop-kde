#!/usr/bin/with-contenv bash
# Pre-seed VLC's per-user config so the first launch doesn't block on
# the privacy/network prompt or pop the update-notification dialog.
#
# Why a runtime script: /config is mounted as tmpfs (--tmpfs /config)
# by the bench's launch_source, so anything baked into /config at
# image-build time gets shadowed. linuxserver's s6 init runs
# /custom-cont-init.d/* before the user session starts; that's the
# right hook for "lay down per-user defaults after the volume mount."
#
# Idempotent: only writes if vlcrc isn't already present, so a user
# who customizes their /config/.config/vlc/vlcrc keeps their changes.

set -euo pipefail

VLC_DIR=/config/.config/vlc
VLCRC=${VLC_DIR}/vlcrc

if [ ! -f "${VLCRC}" ]; then
    mkdir -p "${VLC_DIR}"
    cat > "${VLCRC}" <<'EOF'
[qt]
qt-privacy-ask=0
qt-recentplay=0
qt-updates-notif=0
qt-error-dialogs=0

[core]
metadata-network-access=0
EOF
fi

# KWin window rule: pin VLC's main window to a small bottom-left
# geometry on first creation. Without this, the spec's
# `vlc --no-audio --no-video-title-show` ends up maximized on
# 1920x1080 (KWin smart-placement decision; behaviour differs from
# clicking the .desktop launcher because the argv is different),
# which covers the desktop icons the agent needs to see and
# forces it down a "VLC's file menu" rabbit hole. Pinning the
# initial window size + position keeps the desktop visible.
#
# positionrule=2 + sizerule=2 = "Apply Initially": KWin sets these
# on creation, then leaves the window alone for any later
# user moves/resizes.
KWINRULES=/config/.config/kwinrulesrc
if [ ! -f "${KWINRULES}" ]; then
    cat > "${KWINRULES}" <<'EOF'
[General]
count=1
rules=os4agent-vlc

[os4agent-vlc]
Description=os4agent: pin VLC default size + position
position=80,80
positionrule=2
size=640,400
sizerule=2
wmclass=vlc vlc
wmclassmatch=1
EOF
fi

chown -R abc:abc /config/.config
